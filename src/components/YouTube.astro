---
// A YouTube video embedded in a Post, sized to the column it sits in.
//
// YouTube's copy-paste snippet hardcodes a 560x315 iframe, which overflows a
// phone screen. Stretching the width to 100% doesn't fix it either, because an
// iframe has no intrinsic aspect ratio: the height stays fixed (or collapses)
// while the width changes. The wrapper supplies the 16:9 ratio instead and the
// iframe fills it, so the video scales down on mobile and stops at the
// column's width on desktop.
interface Props {
	// The video's ID, the part after `v=` in a watch URL or after `/embed/`.
	id: string;
	// Required rather than defaulting to "YouTube video player": a screen reader
	// announces this when it reaches the frame, and that default tells nobody
	// which video it is.
	title: string;
	// Optional start offset in seconds.
	start?: number;
}

const { id, title, start } = Astro.props;

// youtube-nocookie.com is YouTube's own privacy-enhanced embed: the same
// player, but it doesn't set tracking cookies until someone actually plays it.
// The `si` share parameter from the copied snippet is dropped for the same
// reason.
const src = new URL(`https://www.youtube-nocookie.com/embed/${id}`);
if (start) src.searchParams.set("start", String(start));
---

<div class="youtube">
	<iframe
		src={src.href}
		title={title}
		loading="lazy"
		allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
		referrerpolicy="strict-origin-when-cross-origin"
		allowfullscreen></iframe>
</div>

<style>
	.youtube {
		aspect-ratio: 16 / 9;
		width: 100%;
		margin-bottom: 2.5rem;
	}
	.youtube iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
