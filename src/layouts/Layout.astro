---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? Astro.props.title ?? "Flotsam";
const description =
	frontmatter?.description ??
	Astro.props.description ??
	"Miscellaneous or unimportant material from Tommy";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// The share card. Only Posts pass an image today; Pages have none, and a
// site-wide fallback for everything else is tracked separately (#2).
const image: ImageMetadata | undefined = Astro.props.image;
const imageAlt: string | undefined = Astro.props.imageAlt;

// The dimensions a card is actually rendered at, so the tags can declare them
// and a scraper can lay the card out without fetching the file first.
const SHARE_WIDTH = 1200;
const SHARE_HEIGHT = 630;

// Deliberately a generated derivative rather than the author's own file: the
// original may be any shape and many megabytes, and `<Image>` would hand back
// WebP, which some scrapers still refuse. A cropped JPEG at a fixed size is the
// one combination that renders everywhere. See ADR 0006.
const shareImage = image
	? await getImage({
			src: image,
			width: SHARE_WIDTH,
			height: SHARE_HEIGHT,
			fit: "cover",
			format: "jpeg",
		})
	: undefined;

// og:image must be absolute — a scraper has no page context to resolve against.
const shareImageURL = shareImage
	? new URL(shareImage.src, Astro.site)
	: undefined;

const nav = [
	{ label: "What", href: "/what" },
	{ label: "Who", href: "/who" },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link
			rel="icon"
			href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🪵</text></svg>"
		/>
		<link rel="stylesheet" href="/sakura-vader.css" />
		<link rel="stylesheet" href="/global.css" />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		{
			shareImageURL && (
				<>
					<meta property="og:image" content={shareImageURL.href} />
					<meta property="og:image:width" content={String(SHARE_WIDTH)} />
					<meta property="og:image:height" content={String(SHARE_HEIGHT)} />
					{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
					{/* Without this X renders a small square crop, or nothing. */}
					<meta name="twitter:card" content="summary_large_image" />
				</>
			)
		}
	</head>
	<body>
		<header>
			{/*
				The site title is deliberately a paragraph, not a heading. It repeats
				on every page, so as an H1 it left each document with two competing H1s
				and no unambiguous page heading. Every page now carries exactly one H1
				of its own (see ADR 0003); this is styled below to look unchanged.
			*/}
			<p class="site-title"><a href="/">FLOTSAM</a></p>
			<nav aria-label="Primary">
				{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</header>
		<hr />
		<slot />
		<hr />
		<p style="text-align: center; font-size: 0.85em;">
			&copy; {new Date().getFullYear()} Tommy O'Keefe
		</p>
		<script>
			import mermaid from 'mermaid';
			mermaid.initialize({ startOnLoad: false, theme: 'dark' });
			mermaid.run({ querySelector: '.language-mermaid' });
		</script>
	</body>

	<style>
		header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 1rem;
			padding-bottom: 0.75rem;
			border-bottom: 1px solid #2c2226;
		}
		/* Restates the sakura h1 rules the site title lost when it stopped
		   being a heading, so the masthead renders identically (ADR 0003). */
		header .site-title {
			font-size: 2.35em;
			font-weight: 700;
			line-height: 1.1;
			margin: 0;
		}
		header nav {
			display: flex;
			gap: 1.75rem;
		}
		header nav a {
			color: #a9a6ad;
			text-transform: uppercase;
			font-size: 0.8em;
			letter-spacing: 0.08em;
			font-weight: 600;
			border-bottom: 1px solid transparent;
			padding-bottom: 0.2rem;
			transition:
				color 0.15s ease,
				border-color 0.15s ease;
		}
		header nav a:hover {
			color: #eb99a1;
			border-bottom-color: #eb99a1;
		}
	</style>
</html>
