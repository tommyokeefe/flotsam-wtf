---
import type { ImageMetadata } from "astro";
import fallbackCard from "../assets/flotsam-share-card.jpg";
import { SHARE_HEIGHT, SHARE_WIDTH, getShareImage } from "../lib/share-image";

// Props accepted by the Layout component
interface Props {
	title?: string;
	description?: string;
	// A Post's own share picture. Falls back to the site card when absent.
	image?: ImageMetadata;
	// Optional here, but the build fails if a Post has an `image` and no alt
	// (the schema's `.refine`, ADR 0006).
	imageAlt?: string;
	// Only a Post is an `article`; see `ogType` below.
	type?: "website" | "article";
	// Passed as a Date and formatted where the tag is rendered, so the tag's
	// required format lives with the tag rather than at the call site. A Draft
	// carries this too, claiming a publish date it hasn't reached: accepted,
	// because a Draft is only reachable from a preview URL handed to someone
	// deliberately (ADR 0004).
	publishedTime?: Date;
	frontmatter?: { title?: string; description?: string };
}

const {
	frontmatter,
	title: titleProp,
	description: descriptionProp,
	image,
	imageAlt,
	type,
	publishedTime,
} = Astro.props;

// The site's own name, as distinct from any one page's title. Declared once
// because the title fallback below needs the same string, and two literals
// three lines apart drift the moment either is edited.
const SITE_NAME = "Flotsam";

const title = frontmatter?.title ?? titleProp ?? SITE_NAME;
const description =
	frontmatter?.description ??
	descriptionProp ??
	"Miscellaneous or unimportant material from Tommy";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// The share card. A Post may bring its own picture; everything else — the
// Pages, the index, and a Post that simply hasn't got one — falls back to the
// site card, so nothing shares as a bare link (#2).
//
// The picture and its alt text are chosen as a pair, never independently.
// Reading `image` from the props while letting `imageAlt` fall through on its
// own would eventually caption one picture with another's description, which
// ADR 0006 calls out as worse than having no alt text at all.
const FALLBACK_ALT =
	"A bare, weather-stripped tree fallen across a tidal flat on a beach of dead trees, in sepia, with FLOTSAM lettered across the lower left.";

const share: { src: ImageMetadata; alt: string | undefined } = image
	? { src: image, alt: imageAlt }
	: { src: fallbackCard, alt: FALLBACK_ALT };

// Open Graph's page type. Only a Post is an `article` — `/`, the Pages, and the
// no-props case are all the site itself. Deliberately just these two values:
// `profile` for /who was considered and declined, because no scraper renders a
// card differently for it and it would widen this to an open vocabulary (#34).
const ogType = type ?? "website";

// Every Post has the same author, so this is a constant rather than a prop — a
// prop would imply a Post could carry a different one. Built from `Astro.site`
// so it can't drift from the origin in astro.config.mjs, and pointed at this
// site rather than a Bluesky profile so the canonical answer to "who wrote
// this" stays on a domain we control.
const AUTHOR_URL = new URL("/who", Astro.site).href;

const shareImage = await getShareImage(share.src);

// og:image must be absolute — a scraper has no page context to resolve against.
const shareImageURL = new URL(shareImage.src, Astro.site);

const nav = [
	{ label: "What", href: "/what" },
	{ label: "Who", href: "/who" },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link
			rel="icon"
			href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🪵</text></svg>"
		/>
		<link rel="stylesheet" href="/sakura-vader.css" />
		<link rel="stylesheet" href="/global.css" />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		{
			ogType === "article" && (
				<>
					{publishedTime && (
						<meta
							property="article:published_time"
							content={publishedTime.toISOString()}
						/>
					)}
					<meta property="article:author" content={AUTHOR_URL} />
				</>
			)
		}
		<meta property="og:url" content={canonicalURL} />
		{/* Without this a renderer labels the card with the bare domain. */}
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:image" content={shareImageURL.href} />
		<meta property="og:image:width" content={String(SHARE_WIDTH)} />
		<meta property="og:image:height" content={String(SHARE_HEIGHT)} />
		<meta property="og:image:alt" content={share.alt} />
		{/* Without this X renders a small square crop, or nothing. */}
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<header>
			{
				/*
				The site title is deliberately a paragraph, not a heading. It repeats
				on every page, so as an H1 it left each document with two competing H1s
				and no unambiguous page heading. Every page now carries exactly one H1
				of its own (see ADR 0003); this is styled below to look unchanged.
			*/
			}
			<p class="site-title"><a href="/">FLOTSAM</a></p>
			<nav aria-label="Primary">
				{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</header>
		<hr />
		<slot />
		<hr />
		<p style="text-align: center; font-size: 0.85em;">
			&copy; {new Date().getFullYear()} Tommy O'Keefe
		</p>
		<script>
			import mermaid from "mermaid";
			mermaid.initialize({ startOnLoad: false, theme: "dark" });
			mermaid.run({ querySelector: ".language-mermaid" });
		</script>
	</body>

	<style>
		header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 1rem;
			padding-bottom: 0.75rem;
			border-bottom: 1px solid #2c2226;
		}
		/* Restates the sakura h1 rules the site title lost when it stopped
		   being a heading, so the masthead renders identically (ADR 0003). */
		header .site-title {
			font-size: 2.35em;
			font-weight: 700;
			line-height: 1.1;
			margin: 0;
		}
		header nav {
			display: flex;
			gap: 1.75rem;
		}
		header nav a {
			color: #a9a6ad;
			text-transform: uppercase;
			font-size: 0.8em;
			letter-spacing: 0.08em;
			font-weight: 600;
			border-bottom: 1px solid transparent;
			padding-bottom: 0.2rem;
			transition:
				color 0.15s ease,
				border-color 0.15s ease;
		}
		header nav a:hover {
			color: #eb99a1;
			border-bottom-color: #eb99a1;
		}
	</style>
</html>
