---
const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title ?? 'dump'}</title>
		<style>
			body {
				max-width: 38rem;
				margin: 2rem auto;
				padding: 0 1rem;
				font-family: system-ui, sans-serif;
				line-height: 1.5;
			}
			a { color: inherit; }
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>
