---
import Layout from "../layouts/Layout.astro";
import { formatPostDate } from "../lib/date";
import { getVisiblePosts, postPath } from "../lib/posts";

// Sorted newest-first by getVisiblePosts, which also decides whether Drafts
// are part of this build at all (ADR 0004).
const posts = await getVisiblePosts();
---

<Layout>
	<h1 class="visually-hidden">Posts</h1>
	<p>
		<a href="/what">Miscellaneous or unimportant material</a> from <a
			href="who">Tommy</a
		>
	</p>
	<ul>
		{
			posts.map((post) => (
				<li>
					<a href={postPath(post)}>{post.data.title}</a> —{" "}
					{formatPostDate(post.data.date)}
					{post.data.draft && <span class="draft-marker">Draft</span>}
				</li>
			))
		}
	</ul>
</Layout>

<style>
	/* The rule ships in every build; the element it styles only renders
	   outside production, where Drafts exist. */
	.draft-marker {
		margin-left: 0.5rem;
		padding: 0.1em 0.45em;
		border: 1px solid #eb99a1;
		border-radius: 0.25em;
		color: #eb99a1;
		font-size: 0.7em;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		vertical-align: middle;
	}
</style>
