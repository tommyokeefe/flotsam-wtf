---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatPostDate } from "../../lib/date";
import { getVisiblePosts } from "../../lib/posts";

// A single, non-rest param: post slugs are flat by decision (ADR 0001), so a
// nested URL like /posts/2027/wind can't be produced by accident.
export async function getStaticPaths() {
	// A Draft is excluded here rather than hidden at render time, so in
	// production no route is emitted for it at all (ADR 0004).
	const posts = await getVisiblePosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
	title={post.data.title}
	description={post.data.description}
	image={post.data.image}
	imageAlt={post.data.imageAlt}
	type="article"
	publishedTime={post.data.date}
>
	<h1>{post.data.title}</h1>
	{
		post.data.draft && (
			<p class="draft-notice">
				Draft — not published, and not reachable on the live site.
			</p>
		)
	}
	<p class="post-date">
		<time datetime={post.data.date.toISOString()}>
			{formatPostDate(post.data.date)}
		</time>
	</p>
	<Content />
</Layout>

<style>
	.post-date {
		font-style: italic;
	}

	/* The rule ships in every build; the element it styles only renders
	   outside production, where Drafts exist. A preview URL is shareable,
	   so a Draft has to announce itself. */
	.draft-notice {
		margin-bottom: 1rem;
		padding: 0.5rem 0.75rem;
		border: 1px solid #eb99a1;
		border-radius: 0.25em;
		color: #eb99a1;
		font-size: 0.8em;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
</style>
